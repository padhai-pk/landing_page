VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local dev (npm run dev): use the Vite proxy — no CORS issues.
# VITE_BACKEND_URL=/api/backend
#
# Production (Vercel): set to your deployed backend URL, e.g.
# VITE_BACKEND_URL=https://your-backend.vercel.app
# Also set ALLOWED_ORIGIN on the backend to your frontend domain.
VITE_BACKEND_URL=
