{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/ambassador-signup",
      "has": [{ "type": "host", "value": "padhai.pk" }],
      "destination": "https://ambassador.padhai.pk/",
      "permanent": true
    },
    {
      "source": "/ambassador-signup",
      "has": [{ "type": "host", "value": "www.padhai.pk" }],
      "destination": "https://ambassador.padhai.pk/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/content.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/share-captions.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}